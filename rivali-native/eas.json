{
  "cli": {
    "version": ">=24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true
    },
    "track-test": {
      "extends": "production",
      "channel": "track-test",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_RIVALI_MODE": "track-test",
        "EXPO_PUBLIC_TRACK_ANALYSIS_URL": "https://rivali-track-analysis.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6819913934"
      }
    }
  }
}
